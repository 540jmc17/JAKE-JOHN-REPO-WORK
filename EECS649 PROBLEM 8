"""EECS 649, Assignment 3, Problem 8 — 3D Squares puzzle solver.

Adapted from the optional instructor scaffold `assignment3_problem8 (1).py`.
Two independent search methods: uninformed DFS and informed Greedy Best-First.

IMPORTANT ABOUT DATA:
  PIECES is a proposed transcription of the photographed 3x3 puzzle, derived
  from the supplied original/goal pictures. The moon A/B distinction is hard
  to read in the photos. Treat this as a candidate encoding and visually
  verify the individual half-images against the physical puzzle if possible.
  The program checks that the photographed reference goal is compatible with
  the proposed encoding, but this is NOT independent proof of transcription.

Piece IDs P0..P8 refer to the photographed INITIAL-state 3x3 grid, row-major.
Each four-entry tuple records image half-IDs in (North, East, South, West)
order. Each move can rotate a tile clockwise 0, 90, 180 or 270 degrees.
Complementary pairs are (0,1), (2,3), (4,5), (6,7).
Only internal touching edges must match. Outer border edges are unrestricted.

Symbol key:
  0 astronaut head/upper half          1 astronaut legs/lower half
  2 space shuttle nose/front half      3 space shuttle wing/rear half
  4 satellite capped/end half          5 satellite body half
  6 moon A half                        7 moon B half

The reference goal is used ONLY as an independent reporting/sanity check;
neither search routine uses it or knows its positions or rotations.
"""

import heapq
import platform
import time
import tracemalloc
from itertools import count

SIZE = 3
NUM_CELLS = SIZE * SIZE

# Candidate transcription; verify moon A/B visually before claiming ground truth.
#                     N  E  S  W
PIECES = [
    (6, 5, 4, 3),   # P0: moon A, satellite body, satellite end, shuttle rear
    (0, 5, 3, 7),   # P1: astronaut head, satellite body, shuttle rear, moon B
    (6, 7, 2, 0),   # P2: moon A, moon B, shuttle nose, astronaut head
    (0, 7, 3, 5),   # P3: astronaut head, moon B, shuttle rear, satellite body
    (6, 2, 5, 1),   # P4: moon A, shuttle nose, satellite body, astronaut legs
    (1, 4, 2, 6),   # P5: astronaut legs, satellite end, shuttle nose, moon A
    (3, 1, 5, 0),   # P6: shuttle rear, astronaut legs, satellite body, head
    (0, 7, 3, 5),   # P7: astronaut head, moon B, shuttle rear, satellite body
    (4, 7, 3, 1),   # P8: satellite end, moon B, shuttle rear, astronaut legs
]

# Inferred from the original page's example GOAL photograph, NOT from search.
# The second number is clockwise quarter-turns relative to the initial photo.
PHOTO_REFERENCE = (
    (2, 0), (0, 3), (6, 1),
    (3, 2), (5, 2), (1, 0),
    (8, 1), (7, 0), (4, 3),
)


def validate_pieces(pieces):
    """Fail early if the symbolic input is incomplete or malformed."""
    if len(pieces) != NUM_CELLS:
        raise ValueError(f"Expected {NUM_CELLS} pieces; received {len(pieces)}.")
    for i, piece in enumerate(pieces):
        if len(piece) != 4 or any(type(edge) is not int or edge not in range(8)
                                  for edge in piece):
            raise ValueError(f"Piece {i} must have four integer edge IDs (0..7).")


def complements(a, b):
    """Check complementary edge IDs under the paired encoding."""
    return (a ^ 1) == b


def rotate(piece, quarter_turns=0):
    """Return (N, E, S, W) after clockwise quarter turns."""
    r = quarter_turns % 4
    return piece[-r:] + piece[:-r] if r else piece


def oriented_piece(piece_id, rotation):
    """Return the four oriented edges of the selected tile."""
    return rotate(PIECES[piece_id], rotation)


def initial_state():
    """A state is (immutable board, frozenset of unused piece IDs)."""
    validate_pieces(PIECES)
    return (None,) * NUM_CELLS, frozenset(range(NUM_CELLS))


def legal(board, cell, oriented_edges):
    """Check compatibility with already placed neighbors north and west."""
    if not (0 <= cell < NUM_CELLS) or board[cell] is not None:
        return False
    row, col = divmod(cell, SIZE)

    if col > 0 and board[cell - 1] is not None:
        left_id, left_rotation = board[cell - 1]
        left_edges = oriented_piece(left_id, left_rotation)
        if not complements(left_edges[1], oriented_edges[3]):
            return False

    if row > 0 and board[cell - SIZE] is not None:
        top_id, top_rotation = board[cell - SIZE]
        top_edges = oriented_piece(top_id, top_rotation)
        if not complements(top_edges[2], oriented_edges[0]):
            return False
    return True


def verify(board):
    """Verify all 9 tiles appear once and all 12 shared boundaries match."""
    if len(board) != NUM_CELLS or any(slot is None for slot in board):
        return False
    try:
        ids = [piece_id for piece_id, _ in board]
        if set(ids) != set(range(NUM_CELLS)) or len(set(ids)) != NUM_CELLS:
            return False
        for cell, (piece_id, rotation) in enumerate(board):
            edges = oriented_piece(piece_id, rotation)
            row, col = divmod(cell, SIZE)
            if col + 1 < SIZE:
                right_id, right_rotation = board[cell + 1]
                right_edges = oriented_piece(right_id, right_rotation)
                if not complements(edges[1], right_edges[3]):
                    return False
            if row + 1 < SIZE:
                bottom_id, bottom_rotation = board[cell + SIZE]
                bottom_edges = oriented_piece(bottom_id, bottom_rotation)
                if not complements(edges[2], bottom_edges[0]):
                    return False
    except (IndexError, KeyError, TypeError, ValueError):
        return False
    return True


def goal(state):
    """Accept any completed, consistently edge-matched arrangement."""
    board, unused = state
    return not unused and verify(board)


def next_empty_cell(state):
    """Return the first empty location in row-major order, or None."""
    board, unused = state
    return next((i for i, slot in enumerate(board) if slot is None), None)


def place(state, cell, piece_id, rotation):
    """Produce a new immutable state with one legal piece placement."""
    board, unused = state
    if piece_id not in unused or not legal(board, cell, oriented_piece(piece_id, rotation)):
        raise ValueError("Piece was already used or does not fit this cell")
    updated = list(board)
    updated[cell] = (piece_id, rotation % 4)
    return tuple(updated), unused - {piece_id}


def path_cost(state):
    """Each placed tile contributes a unit path cost."""
    return NUM_CELLS - len(state[1])


# ------------------------------------------------------------
# TODO 1 completed: successor generation.
# ------------------------------------------------------------
def successors(state):
    """Yield each legal unused-piece/rotation placement for the next cell."""
    board, unused = state
    cell = next_empty_cell(state)
    if cell is None:
        return

    for piece_id in sorted(unused):
        for rotation in range(4):
            if legal(board, cell, oriented_piece(piece_id, rotation)):
                yield place(state, cell, piece_id, rotation)


