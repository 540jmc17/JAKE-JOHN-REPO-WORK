/**
 * Module: ai-controller.ts
 *
 * Purpose:
 * Controls when the player and Easy AI are allowed to make moves.
 *
 * The Minesweeper rules themselves stay inside game.ts.
 *
 * This controller handles:
 * - Manual player mode
 * - Player + Easy AI alternating turns
 * - Automatic Easy AI play
 * - Starting and pausing automatic AI
 * - Preventing multiple AI timers from running
 * - Preventing player input while the AI is taking its turn
 * - Stopping the AI when the game is won or lost
 *
 * Project 2 Addition
 * Jake Crawford + John
 */

import {
    makeEasyAIMove,
    revealCell,
    toggleFlag
} from './game.js';

import type {
    Board,
    Cell
} from './types.js';


export type PlayMode =
    | 'manual'
    | 'alternating'
    | 'automatic';


export type MoveSolver =
    (board: Board) => boolean;


export class AIController {

    private currentMode: PlayMode =
        'manual';

    private waitingForAI =
        false;

    private autoRunning =
        false;

    private disposed =
        false;

    private timer:
        ReturnType<typeof setTimeout> |
        undefined;

    private notice =
        '';


    constructor(
        private readonly board: Board,
        private readonly onUpdate: () => void,
        private readonly solver: MoveSolver =
            makeEasyAIMove,
        private readonly delayMs =
            500
    ) {

        if (
            !Number.isFinite(delayMs) ||
            delayMs <= 0
        ) {

            throw new RangeError(
                'The AI delay must be a positive, finite number.'
            );
        }
    }


    get mode(): PlayMode {
        return this.currentMode;
    }


    get isAutoRunning(): boolean {
        return this.autoRunning;
    }


    get isWaitingForAI(): boolean {
        return this.waitingForAI;
    }


    private get active(): boolean {

        return (
            !this.disposed &&
            (
                this.board.gameStatus === 'ready' ||
                this.board.gameStatus === 'playing'
            )
        );
    }


    get canPlayerAct(): boolean {

        return (
            this.active &&
            this.currentMode !== 'automatic' &&
            !this.waitingForAI
        );
    }


    get canStep(): boolean {

        return (
            this.active &&
            this.currentMode === 'manual'
        );
    }


    get statusText(): string {

        if (this.disposed) {
            return 'This game has been closed.';
        }


        if (this.board.gameStatus === 'won') {
            return 'Game won. AI stopped.';
        }


        if (this.board.gameStatus === 'lost') {
            return 'Game over. AI stopped.';
        }


        if (this.notice) {
            return this.notice;
        }


        if (this.currentMode === 'manual') {

            return (
                'Your move. You may also request one Easy AI move.'
            );
        }


        if (this.currentMode === 'alternating') {

            return this.waitingForAI
                ? 'Easy AI turn...'
                : 'Your turn: reveal or toggle one flag.';
        }


        return this.autoRunning
            ? 'Easy AI is playing automatically.'
            : 'Automatic mode paused. Start the AI, or choose Manual to play.';
    }


    setMode(
        mode: PlayMode
    ): void {

        if (this.disposed) {
            return;
        }


        if (
            ![
                'manual',
                'alternating',
                'automatic'
            ].includes(mode)
        ) {

            throw new RangeError(
                'Unknown play mode.'
            );
        }


        this.cancelTimer();

        this.waitingForAI =
            false;

        this.autoRunning =
            false;

        this.notice =
            '';

        this.currentMode =
            mode;

        this.onUpdate();
    }


    private cellAt(
        row: number,
        col: number
    ): Cell | undefined {

        if (
            !Number.isInteger(row) ||
            !Number.isInteger(col) ||
            row < 0 ||
            col < 0 ||
            row >= this.board.rows ||
            col >= this.board.cols
        ) {

            return undefined;
        }


        return this.board.cells[row][col];
    }


    reveal(
        row: number,
        col: number
    ): boolean {

        if (
            !this.canPlayerAct ||
            this.cellAt(row, col)?.state !== 'covered'
        ) {

            return false;
        }


        revealCell(
            this.board,
            row,
            col
        );


        this.afterPlayerMove();

        return true;
    }


    flag(
        row: number,
        col: number
    ): boolean {

        if (!this.canPlayerAct) {

            return false;
        }


        const cell =
            this.cellAt(row, col);


        if (
            !cell ||
            cell.state === 'revealed'
        ) {

            return false;
        }


        const previousState =
            cell.state;


        toggleFlag(
            this.board,
            row,
            col
        );


        if (
            cell.state === previousState
        ) {

            return false;
        }


        this.afterPlayerMove();

        return true;
    }


    private afterPlayerMove(): void {

        this.notice =
            '';


        if (
            this.currentMode === 'alternating' &&
            this.active
        ) {

            this.waitingForAI =
                true;

            this.scheduleMove();
        }


        this.onUpdate();
    }


    step(): boolean {

        if (!this.canStep) {

            return false;
        }


        const moved =
            this.performAIMove();


        this.onUpdate();

        return moved;
    }


    startAuto(): boolean {

        if (
            !this.active ||
            this.currentMode !== 'automatic' ||
            this.autoRunning
        ) {

            return false;
        }


        this.notice =
            '';

        this.autoRunning =
            true;

        this.scheduleMove();

        this.onUpdate();

        return true;
    }


    pauseAuto(): void {

        if (
            this.disposed ||
            this.currentMode !== 'automatic'
        ) {

            return;
        }


        this.cancelTimer();

        this.autoRunning =
            false;

        this.onUpdate();
    }


    dispose(): void {

        this.cancelTimer();

        this.autoRunning =
            false;

        this.waitingForAI =
            false;

        this.disposed =
            true;
    }


    private cancelTimer(): void {

        if (
            this.timer !== undefined
        ) {

            clearTimeout(
                this.timer
            );

            this.timer =
                undefined;
        }
    }


    private performAIMove(): boolean {

        this.notice =
            '';


        try {

            const moved =
                this.solver(
                    this.board
                );


            if (!moved) {

                this.notice =
                    'No covered, unflagged cells remain. Choose Manual to review flags.';
            }


            return moved;

        } catch (
            error: unknown
        ) {

            this.notice =
                `AI stopped: ${
                    error instanceof Error
                        ? error.message
                        : 'unexpected solver error'
                }`;


            return false;
        }
    }


    private scheduleMove(): void {

        this.cancelTimer();


        this.timer =
            setTimeout(
                () => {

                    this.timer =
                        undefined;


                    if (!this.active) {

                        this.autoRunning =
                            false;

                        this.waitingForAI =
                            false;


                        if (!this.disposed) {

                            this.onUpdate();
                        }


                        return;
                    }


                    const moved =
                        this.performAIMove();


                    this.waitingForAI =
                        false;


                    if (
                        this.currentMode === 'automatic'
                    ) {

                        this.autoRunning =
                            moved &&
                            this.active;


                        if (
                            this.autoRunning
                        ) {

                            this.scheduleMove();
                        }
                    }


                    this.onUpdate();

                },

                this.delayMs
            );
    }
}
